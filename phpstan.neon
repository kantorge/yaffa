includes:
    - ./vendor/larastan/larastan/extension.neon

parameters:

    paths:
        - app/

    # The level 9 is the highest level
    level: 5

    ignoreErrors:
        - '#PHPDoc tag @var#'
        # Pre-existing defensive instanceof checks against a non-nullable BelongsTo relation;
        # only became visible to PHPStan once CurrencyRate's docblock/attribute ordering was
        # fixed (see CurrencyRate.php) as part of the precision-improvements work.
        -
            message: '#Instanceof between App\\Models\\Currency and App\\Models\\Currency will always evaluate to true\.#'
            path: app/Observers/CurrencyRateObserver.php
        # False positive: Illuminate\Support\Collection's TValue template is declared
        # non-covariant, so PHPStan can't confirm a Collection<int, array{...}> passed from
        # one method to another with an identical @param shape is still that same shape -
        # see https://phpstan.org/blog/whats-up-with-template-covariant. Introduced by
        # getLatestPricesBatch() delegating to getLatestPricesBatchExact() (both typed
        # identically) as part of the precision-improvements work.
        -
            message: '#Parameter \#1 \$requests of method App\\Services\\InvestmentService::getLatestPricesBatchExact\(\) expects#'
            path: app/Services/InvestmentService.php

    excludePaths:
        - ./*/*/FileToBeExcluded.php
