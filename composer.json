{
    "name": "kantorge/yaffa",
    "description": "Yet Another Free Financial Application: a free, self-hosted personal finance app",
    "version": "3.0.0",
    "type": "project",
    "keywords": [
        "personal finance",
        "laravel",
        "yaffa"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-bcmath": "*",
        "beyondcode/laravel-mailbox": "^6.0",
        "bkwld/cloner": "^3.14",
        "brick/math": "^0.14",
        "brick/money": "^0.11.2",
        "dedoc/scramble": "^0.13.22",
        "diglactic/laravel-breadcrumbs": "^10.1",
        "edgaras/strsim": "^1.1",
        "ezyang/htmlpurifier": "^4.19",
        "google/apiclient": "^2.19",
        "guzzlehttp/guzzle": "^7.10",
        "intervention/image": "^3.11",
        "kantorge/laravel-currency-exchange-rates": "^2.0",
        "laracasts/utilities": "^3.2",
        "laragear/two-factor": "^4.0",
        "laravel/framework": "^13.29",
        "laravel/sanctum": "^4.3",
        "laravel/telescope": "^5.18",
        "laravel/ui": "^4.6",
        "league/csv": "^9.21",
        "prism-php/prism": "^0.99.19",
        "sentry/sentry-laravel": "^4.20",
        "simshaun/recurr": "^5.0",
        "smalot/pdfparser": "^2.0",
        "spatie/laravel-model-flags": "^1.4",
        "spatie/laravel-onboard": "^2.6",
        "symfony/css-selector": "^8.1",
        "symfony/dom-crawler": "^8.1",
        "symfony/http-client": "^7.4",
        "tightenco/ziggy": "^2.6"
    },
    "require-dev": {
        "albertoarena/laravel-truss": "^1.9",
        "alebatistella/duskapiconf": "^1.2",
        "barryvdh/laravel-ide-helper": "^3.7",
        "deployer/deployer": "^7.5",
        "fakerphp/faker": "^1.23",
        "fruitcake/laravel-debugbar": "^4.0",
        "joshembling/artisan-browse": "^0.0.7",
        "larastan/larastan": "^3.9",
        "laravel/boost": "^2.2",
        "laravel/dusk": "^8.3",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.53",
        "laravel/tinker": "^3.0",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.22",
        "roquie/laravel-dusk-select2": "dev-custom_package"
    },
    "config": {
        "discard-changes": true,
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Helpers/OcrHelpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Tests\\": "tests/"
        }
    },
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "post-update-cmd": [
            "@php artisan ide-helper:generate",
            "@php artisan ide-helper:meta",
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "Illuminate\\Foundation\\ComposerScripts::postUpdate",
            "@php artisan boost:update --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite"
        ],
        "coverage": [
            "@putenv SAIL_XDEBUG_MODE=coverage",
            "bash -c './vendor/bin/sail artisan test --coverage-html public/coverage/$(date +%Y-%m-%d-%H-%M)'"
        ],
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/kantorge/laravel-dusk-select2"
        }
    ],
    "minimum-stability": "stable"
}
